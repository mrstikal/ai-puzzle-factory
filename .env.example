# Live inference inputs. Every value is empty by default; there is no default key or model.
# Copy this file to .env only for a later live phase. Never commit a real key.
OPENROUTER_API_KEY=
GENERATOR_MODEL=
GENERATOR_PROVIDER=
REVIEWER_MODEL=
REVIEWER_PROVIDER=
VISION_REVIEWER_MODEL=
VISION_REVIEWER_PROVIDER=

# Documented fixed limits (not secrets and not environment overrides):
# - request deadline: 90000 ms
# - response bytes: 2097152 (2 MiB)
# - input JSON text excluding base64: 65536 bytes (64 KiB)
# - PNG: 1048576 bytes (1 MiB)
# - default output cap: 8192 tokens for spec/wording, 4096 tokens per review
# - preflight prompt reserve: 16384 text tokens, 32768 vision tokens
# - output cap field: max_tokens when advertised, otherwise max_completion_tokens
# - provider tags are exact catalog tags, including variant suffixes; no wildcards
# - generator, text reviewer, and vision reviewer model IDs follow role separation
