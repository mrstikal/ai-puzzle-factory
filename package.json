{
  "name": "ai-puzzle-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auditable offline-first proof-of-concept pipeline for generated multiple-choice puzzles",
  "engines": {
    "node": "24.22.2"
  },
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "tsx tests/browser/generate-fixture.ts && playwright test",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "experiment": "tsx src/cli/experiment.ts",
    "preview": "tsx src/cli/preview.ts",
    "calibration": "tsx src/cli/calibration.ts",
    "preflight": "tsx src/cli/preflight.ts",
    "report": "tsx src/cli/report.ts",
    "export": "tsx src/cli/export.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "better-sqlite3": "13.0.3",
    "commander": "15.0.0",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.9",
    "pngjs": "7.0.0",
    "proper-lockfile": "4.1.2",
    "saxes": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "@types/proper-lockfile": "4.1.4",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
